# --- platform -------------------------------------------------------------
# Which generation API answers. Unset: fal when FAL_KEY is present, otherwise
# the Higgsfield platform.
GENERATION_PROVIDER=

# Higgsfield platform (default origin https://api.higgsfield.ai)
HF_API_BASE_URL=
# Optional server-held Higgsfield key (id:secret). Development only unless
# ALLOW_SERVER_KEY=1 — on a public URL it lets every visitor spend it.
HF_API_KEY=

# fal (https://fal.ai/dashboard/keys) — id:secret. Same development-only rule.
FAL_KEY=
ALLOW_SERVER_KEY=

# --- uploads ----------------------------------------------------------------
# Vercel Blob token. Optional on fal: uploads go to fal storage without it.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# --- studio -----------------------------------------------------------------
# Where finished outputs are archived (default ./outputs in development, off
# in production unless set). Extra CDN hosts to allow, comma-separated.
OUTPUT_DIR=
ARCHIVE_HOSTS=
NEXT_PUBLIC_POLL_DEADLINE_MINUTES=20
NEXT_PUBLIC_HISTORY_CAP=200
